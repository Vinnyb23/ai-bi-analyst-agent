# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM provider to use for SQL generation, summarization, report
# drafting, and RAG answer synthesis: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Only ONE of these needs to be set, matching LLM_PROVIDER above.
# Leave both blank to run the whole app in zero-key fallback mode:
# - text-to-SQL falls back to 5 canned queries (keyword-matched)
# - RAG answers fall back to raw retrieved passages with citations
# - the BI-analyst summary/report steps fall back to deterministic templates
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
